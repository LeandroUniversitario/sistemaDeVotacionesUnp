        <mxCell id="ttl-1083" parent="1" vertex="1" value="Clases = tablas de la BD MariaDB (atributos sin cambios) · Operaciones = casos de uso del backend Spring Boot (pe.unp.elecciones) y procedimientos almacenados · Multiplicidades según claves foráneas" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#555555;">
