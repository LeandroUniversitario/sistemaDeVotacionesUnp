@startuml Diagrama_Componentes_RationalRose
' ==============================================================================
' DIAGRAMA DE COMPONENTES - SISTEMA DE ELECCIONES UNP
' Estilo: Rational Rose Oficial (UML 1.4 - Component View)
' Estética idéntica a la plantilla de Rational Rose:
'   - Icono clásico de componente con 2 pestañas (componentStyle uml1)
'   - Fondo amarillo pastel / crema (#FFFFCC)
'   - Bordes y flechas color vino / burgundy (#8B1C3F)
'   - Base de datos representada con cilindro (database "BD")
'   - Nota en la esquina superior izquierda
' ==============================================================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam defaultFontColor #000000

' Icono clásico UML 1.4 de Rational Rose (rectángulo con dos pestañas a la izquierda)
skinparam componentStyle uml1
left to right direction

skinparam component {
  BorderColor #8B1C3F
  BackgroundColor #FFFFCC
  FontColor #000000
  FontSize 11
}

skinparam database {
  BorderColor #8B1C3F
  BackgroundColor #FFFFCC
  FontColor #000000
  FontSize 11
}

skinparam note {
  BorderColor #8B1C3F
  BackgroundColor #FFFFCC
  FontColor #000000
  FontSize 11
}

skinparam arrow {
  Color #8B1C3F
  FontColor #8B1C3F
  FontSize 10
}

' Nota de título en la esquina superior izquierda (estilo Rational Rose)
note as N1
DIAGRAMA DE
COMPONENTES
end note

' ==============================================================================
' COMPONENTES DE ENTRADA / CLIENTES (LADO IZQUIERDO)
' ==============================================================================
component "comite_electoral" as comite
component "mesa_sufragio" as mesa
component "cabina_votacion" as cabina

' ==============================================================================
' COMPONENTES DEL SISTEMA / LÓGICA DE NEGOCIO (CENTRO)
' ==============================================================================
component "mantenimiento" as mant
component "gestion_procesos" as proc
component "jornada_votacion" as voto
component "escrutinio_computo" as esc
component "reporte" as rep

' ==============================================================================
' BASE DE DATOS (LADO DERECHO)
' ==============================================================================
database "BD" as bd

' Relaciones de dependencia de los clientes hacia los módulos del sistema
comite ..> mant
comite ..> proc
comite ..> rep

mesa ..> voto
mesa ..> esc
mesa ..> rep

cabina ..> voto

' Relaciones de dependencia de los módulos hacia la Base de Datos
mant ..> bd
proc ..> bd
voto ..> bd
esc ..> bd
rep ..> bd

@enduml
