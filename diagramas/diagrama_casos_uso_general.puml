@startuml Diagrama_Casos_Uso_General
left to right direction
skinparam nodesep 50
skinparam ranksep 150
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam backgroundcolor transparent
skinparam defaultFontName Helvetica

skinparam usecase {
    BackgroundColor #EAF4FC
    BorderColor #2980B9
    FontSize 13
    ArrowColor #2980B9
}

skinparam actor {
    BackgroundColor #FDEBD0
    BorderColor #D35400
    FontSize 13
    FontColor #D35400
}

skinparam rectangle {
    BackgroundColor #FAFAFA
    BorderColor #2C3E50
    FontSize 15
    FontStyle bold
}

skinparam package {
    BackgroundColor #F0F8FF
    BorderColor #5DADE2
    FontSize 12
    FontStyle bold
    FontColor #1A5276
}

' ==========================================
' ACTORES IZQUIERDA
' ==========================================
together {
    actor "Administrador" as admin
    actor "Representante\nde lista" as representante
    actor "Docente elector" as elector
}

' ==========================================
' ACTORES DERECHA
' ==========================================
together {
    actor "CEUNP" as comite
    actor "Miembro de mesa" as miembroMesa
    actor "Personero general" as personeroGeneral
    actor "Personero de mesa" as personeroMesa
}

' ==========================================
' SISTEMA SICEUNP
' ==========================================
rectangle "Sistema de Control de Elecciones Universitarias (SICEUNP)" {

    ' --- Acceso ---
    package "Acceso al Sistema" {
        usecase "Autenticar usuario" as UC_Auth
    }

    ' --- Administración ---
    package "Administración" {
        usecase "Gestionar usuarios y roles" as UC_Users
        usecase "Configurar parámetros globales" as UC_Params
        usecase "Consultar bitácora de auditoría" as UC_Bitacora
        usecase "Gestionar catálogo de\ncargos institucionales" as UC_Catalogo
        usecase "Gestionar autoridades\ndocentes" as UC_Autoridades
    }

    ' --- Proceso Electoral ---
    package "Proceso Electoral" {
        usecase "Crear proceso electoral" as UC_Proceso
        usecase "Gestionar padrón electoral" as UC_Padron
        usecase "Inscribir lista electoral" as UC_Listas
        usecase "Validar candidaturas y listas" as UC_ValidarListas
        usecase "Gestionar tachas electorales" as UC_Tachas
        usecase "Realizar sorteos de\ncédula y mesa" as UC_Sorteo
        usecase "Configurar exclusiones\nde sorteo" as UC_Exclusiones
    }

    ' --- Acreditaciones y Credenciales ---
    package "Acreditación y Credenciales" {
        usecase "Acreditar y gestionar personeros" as UC_Personeros
        usecase "Generar credenciales y pases QR" as UC_Credenciales
    }

    ' --- Votación ---
    package "Votación" {
        usecase "Validar habilitación\ndel elector" as UC_Validar
        usecase "Emitir voto en cabina" as UC_Voto
    }

    ' --- Escrutinio, Impugnaciones y Cómputo ---
    package "Mesa Electoral y Resultados" {
        usecase "Instalar mesa y\nrealizar escrutinio" as UC_Escrutinio
        usecase "Gestionar impugnaciones\ny nulidades" as UC_Impugnaciones
        usecase "Realizar cómputo general\ny proclamación" as UC_Computo
    }
}

' ==========================================
' CONEXIONES — ADMINISTRADOR
' ==========================================
admin -[#2980B9]-> UC_Auth
admin -[#2980B9]-> UC_Users
admin -[#2980B9]-> UC_Params
admin -[#2980B9]-> UC_Bitacora
admin -[#2980B9]-> UC_Catalogo
admin -[#2980B9]-> UC_Autoridades

' ==========================================
' CONEXIONES — REPRESENTANTE DE LISTA
' ==========================================
representante -[#8E44AD]-> UC_Auth
representante -[#8E44AD]-> UC_Listas
representante -[#8E44AD]-> UC_Personeros

' ==========================================
' CONEXIONES — DOCENTE ELECTOR
' ==========================================
elector -[#D35400]-> UC_Auth
elector -[#D35400]-> UC_Validar
elector -[#D35400]-> UC_Voto
elector -[#D35400]-> UC_Credenciales

' ==========================================
' CONEXIONES — CEUNP
' ==========================================
UC_Auth <-[#27AE60]- comite
UC_Proceso <-[#27AE60]- comite
UC_Padron <-[#27AE60]- comite
UC_ValidarListas <-[#27AE60]- comite
UC_Tachas <-[#27AE60]- comite
UC_Sorteo <-[#27AE60]- comite
UC_Exclusiones <-[#27AE60]- comite
UC_Personeros <-[#27AE60]- comite
UC_Credenciales <-[#27AE60]- comite
UC_Impugnaciones <-[#27AE60]- comite
UC_Computo <-[#27AE60]- comite

' ==========================================
' CONEXIONES — MIEMBRO DE MESA
' ==========================================
UC_Auth <-[#16A085]- miembroMesa
UC_Validar <-[#16A085]- miembroMesa
UC_Escrutinio <-[#16A085]- miembroMesa
UC_Impugnaciones <-[#16A085]- miembroMesa

' ==========================================
' CONEXIONES — PERSONERO GENERAL
' (Fiscaliza todo el proceso electoral)
' ==========================================
UC_Auth <-[#C0392B]- personeroGeneral
UC_ValidarListas <-[#C0392B]- personeroGeneral
UC_Credenciales <-[#C0392B]- personeroGeneral
UC_Escrutinio <-[#C0392B]- personeroGeneral
UC_Impugnaciones <-[#C0392B]- personeroGeneral

' ==========================================
' CONEXIONES — PERSONERO DE MESA
' (Fiscaliza en el ámbito de su mesa)
' ==========================================
UC_Auth <-[#E84393]- personeroMesa
UC_Credenciales <-[#E84393]- personeroMesa
UC_Escrutinio <-[#E84393]- personeroMesa
UC_Impugnaciones <-[#E84393]- personeroMesa

' ==========================================
' RELACIONES INCLUDE / EXTEND
' ==========================================
UC_Voto .> UC_Validar : <<include>>
UC_Sorteo .> UC_Exclusiones : <<include>>

@enduml
