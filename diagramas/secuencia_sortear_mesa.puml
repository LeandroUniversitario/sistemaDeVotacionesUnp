@startuml Diagrama_Secuencia_Sortear_Mesa
title Caso de uso: Sortear miembros de mesa

actor "CEUNP" as Comite
actor "Personero acreditado" as Personero
boundary "SorteoMesaView" as Vista
control "SorteoMesaController" as Controlador
database "DocenteRepository" as DocRepo
database "CandidaturaRepository" as CandidatoRepo
database "CargoAdministrativoRepository" as CargoAdminRepo
database "MesaElectoralRepository" as MesaRepo
database "AuditoriaRepository" as AuditoriaRepo
entity "MesaElectoral" as Mesa

Comite -> Vista: iniciarSorteo(idProceso)
activate Vista
Vista -> Controlador: validarEstadoProceso(idProceso)
activate Controlador
Controlador --> Vista: proceso listo para sorteo

Comite -> Vista: ingresar semilla y confirmar
Vista -> Controlador: ejecutarSorteo(idProceso, semilla)

Controlador -> DocRepo: obtenerDocentesHabilitados(idProceso)
activate DocRepo
DocRepo --> Controlador: docentes habilitados
deactivate DocRepo

Controlador -> CandidatoRepo: obtenerCandidaturasAdmitidas(idProceso)
CandidatoRepo --> Controlador: docentes candidatos
Controlador -> CargoAdminRepo: obtenerCargosVigentesExcluidos()
CargoAdminRepo --> Controlador: docentes con impedimento

Controlador -> Controlador: excluir candidatos e impedidos
Controlador -> Controlador: validar universo y cantidad de mesas

alt No hay suficientes docentes elegibles
    Controlador --> Vista: error: universo insuficiente
    Vista --> Comite: mostrar error
else Universo válido
    loop Por cada mesa
        Controlador -> Controlador: seleccionar con semilla
        Controlador -> Controlador: asignar 3 titulares y suplentes
        Controlador -> Mesa: crear(numero, ubicación, semilla)
        Controlador -> Mesa: asignarMiembros(Presidente, Secretario, Vocal, Suplentes)
        Controlador -> MesaRepo: guardar(mesa y miembros)
    end

    Controlador -> AuditoriaRepo: registrarSorteo(idProceso, semilla, resultado)
    Controlador --> Vista: mostrar resultados y credenciales QR
    Vista --> Comite: publicar resultados del sorteo
    Vista --> Personero: permitir consulta del sorteo
end

deactivate Controlador
deactivate Vista
@enduml
