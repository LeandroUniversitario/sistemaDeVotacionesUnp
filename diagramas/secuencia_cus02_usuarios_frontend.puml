@startuml Diagrama_Secuencia_Frontend_Usuarios
skinparam style strictuml

title Diagrama de Secuencia del Frontend React - CUS-02 Gestionar Usuarios

actor "Administrador" as Actor
participant "UsuariosPage.jsx" as Componente
participant "useState" as Estado
participant "fetch / API" as API
participant "DOM / UI" as UI

Actor -> Componente: Ingresa a módulo Usuarios
activate Componente
Componente -> API: GET /api/auth/users
activate API
API --> Componente: listaUsuariosJSON
deactivate API
Componente -> Estado: setUsers(listaUsuarios)
Componente -> UI: Mostrar tabla de usuarios
deactivate Componente

Actor -> UI: Clic en "Nuevo Usuario"
UI -> Componente: abrirModal()
Componente -> Estado: setModalState(...)

Actor -> Componente: Completa formulario y guarda
activate Componente
Componente -> Componente: validarFormulario()
alt datos válidos
    Componente -> API: POST /api/auth/users
    activate API
    API --> Componente: respuestaJSON
    deactivate API
    alt éxito
        Componente -> Estado: actualizar estado de tabla
        Componente -> UI: Cerrar modal y mostrar mensaje de éxito
    else error de validación (ej. duplicado)
        Componente -> UI: Mostrar error (errData.detail)
    end
end
deactivate Componente
@enduml
